# --- Plugin & Interface ---
plugin      rp-pppoe.so ${interface}
unit        0

# --- IPv4 Einstellungen ---
noipdefault                 # keine selbstgewählte lokale IP
defaultroute                # erst wenn IPCP steht; networkd legt sie zu früh an

# --- IPv6 Einstellungen ---
+ipv6                       # nur Link-Local, Präfix und Route holt systemd-networkd per DHCPv6/RA

# --- Verbindungsmanagement ---
# kein persist: pppd beendet sich beim Abbruch, systemd wählt neu ein

# --- LCP‐Keepalive (zuverlässiger Ausfall-Check) ---
lcp-echo-interval 20
lcp-echo-failure 3

# --- Sicherheit / Logging ---
hide-password                # Passwort nicht im Log anzeigen
noauth                       # Auth nur über chap-secrets

# --- Zugangsdaten (nur Username, das Passwort kommt aus /etc/ppp/chap-secrets) ---
user "${user}"
