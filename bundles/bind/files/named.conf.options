options {
  directory "/var/cache/bind";
  dnssec-validation auto;

  listen-on-v6 { any; };
  allow-query { any; };

  max-cache-size 30%;
  # keep expired records and answer with them while the authoritative servers are unreachable
  stale-cache-enable yes;
  stale-answer-enable yes;
  # explicit: without the option a reload keeps the previous state
  querylog no;

% if type == 'master':
  notify yes;
  also-notify { ${' '.join(sorted(f'{ip};' for ip in slave_ips))} };
  allow-transfer { ${' '.join(sorted(f'{ip};' for ip in slave_ips))} };
% endif
};
