#!/bin/bash

set -exu

path=$1
uuid=$(jq -r .client_uuid < /etc/backup/config.json)
server=$(jq -r .server_hostname < /etc/backup/config.json)
user=$(jq -r .server_user < /etc/backup/config.json)
ssh="ssh -o ConnectTimeout=5 $user@$server"

if test -d "$path"
then
  postfix="/"
elif test -f "$path"
then
  postfix=""
else
  exit 1
fi

# the server keeps ownership in xattrs, it runs rsync as the unprivileged $user
rsync -av --rsync-path="rsync --fake-super" "$path$postfix" "$user@$server:/mnt/backups/$uuid$path$postfix"
