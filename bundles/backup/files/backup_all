#!/bin/bash

set -u

# FIXME: inelegant
% if wol_command:
${wol_command}
% endif

exit=0
failed_paths=""

for path in $(jq -r '.paths | .[]' < /etc/backup/config.json)
do
  echo backing up $path
  /opt/backup/backup_path "$path"
  path_exit=$?
  if [ $path_exit -eq 97 ]
  then
    # the server is unreachable, every further path would fail the same way
    echo "ERROR: backup server unreachable, skipping the remaining paths" >&2
    exit=5
    failed_paths="$failed_paths $path (and all after it)"
    break
  elif [ $path_exit -ne 0 ]
  then
    echo ERROR: backing up $path failed >&2
    exit=5
    failed_paths="$failed_paths $path"
  fi
done

if [ $exit -ne 0 ]
then
  echo "ERROR: failed to backup paths: $failed_paths" >&2
fi

exit $exit
