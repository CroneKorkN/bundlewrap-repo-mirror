#!/bin/bash

set -euo pipefail

path=$1
uuid=$(jq -r .client_uuid < /etc/backup/config.json)
server=$(jq -r .server_hostname < /etc/backup/config.json)
user=$(jq -r .server_user < /etc/backup/config.json)
ssh="ssh -o ConnectTimeout=5 $user@$server"

source_dataset=$(zfs list -H -o mountpoint,name | grep -P "^$path\t" | cut -d $'\t' -f 2 || true)
target_dataset="tank/$uuid/$source_dataset"
target_dataset_parent=${target_dataset%/*}
bookmark_prefix="auto-backup_"
new_bookmark="$bookmark_prefix$(date +"%Y-%m-%d_%H:%M:%S")"

for var in path uuid server user ssh source_dataset target_dataset target_dataset_parent new_bookmark
do
  [[ -z "${!var}" ]] && echo "ERROR - $var is empty" && exit 96
done

$ssh true || { echo "ERROR - cant ssh connect to $server"; exit 97; }

echo "BACKUP ZFS DATASET - PATH: $path, SERVER: $server, UUID: $uuid, SOURCE_DATASET: $source_dataset, TARGET_DATASET: $target_dataset"

# grep without -q reads to the end, an early exit would fail ssh with SIGPIPE under pipefail
if ! $ssh zfs list -t filesystem -H -o name | grep -x "$target_dataset_parent" > /dev/null
then
  echo "CREATING PARENT DATASET..."
  # -u: only root may mount, the parent inherits mountpoint=none anyway
  $ssh zfs create -p -u "$target_dataset_parent"
fi

last_bookmark=$(zfs list -t bookmark -H -o name "$source_dataset" | { grep "^$source_dataset#$bookmark_prefix" || true; } | sort | tail -1 | cut -d '#' -f 2)

zfs snap "$source_dataset@$new_bookmark"
# the snapshot only serves this send, on success it lives on as a bookmark
trap 'zfs destroy "$source_dataset@$new_bookmark"' EXIT

if [[ -z "$last_bookmark" ]]
then
  echo "INITIAL BACKUP"
  zfs send -v "$source_dataset@$new_bookmark" | $ssh zfs recv -u -F "$target_dataset"
else
  echo "INCREMENTAL BACKUP FROM $last_bookmark"
  zfs send -v -L -i "#$last_bookmark" "$source_dataset@$new_bookmark" | $ssh zfs recv -u "$target_dataset"
fi

# the new bookmark first: interrupted in between, the next run still finds one to send from
zfs bookmark "$source_dataset@$new_bookmark" "$source_dataset#$new_bookmark"
for old_bookmark in $(zfs list -t bookmark -H -o name "$source_dataset" | { grep "^$source_dataset#$bookmark_prefix" || true; } | grep -vx "$source_dataset#$new_bookmark" || true)
do
  zfs destroy "$old_bookmark"
done

echo "SUCCESS"
